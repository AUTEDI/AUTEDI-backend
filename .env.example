# Copy to .env beside build.gradle and fill in your values. Never commit .env.
SPRING_PROFILES_ACTIVE=local

# Local MySQL Database Connection
LOCAL_DB_URL=jdbc:mysql://localhost:3306/autedi?allowPublicKeyRetrieval=true&useSSL=false&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=

# Server & Swagger
PORT=8080
SWAGGER_ENABLED=true
SWAGGER_USER=autedi
SWAGGER_PASSWORD=autedi2026!

# JWT
JWT_SECRET=autedi-local-dev-secret-key-must-be-at-least-32-bytes-long-2026

# SMTP Mail Server (Gmail / AWS SES)
# 미설정 시 콘솔 로그로 대체 출력됩니다.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@autedi.com
MAIL_FROM_NAME=AUTEDI
FRONTEND_URL=http://localhost:3000

# AWS S3 Configuration (개발 배포 및 로컬 테스트용)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=autedi-mvp-develop-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI Experiments
OPENAI_API_KEY=
